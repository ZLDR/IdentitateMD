---
import Logo from './Logo.astro';
// Footer component

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<footer class:list={[
  'mt-auto border-t',
  dark ? 'bg-[#0a0a0a] border-[#1a1a1a]' : 'bg-white border-surface-200',
]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Brand -->
      <div>
        <div class="mb-3">
          <Logo class:list={['h-9 max-w-[200px]', dark && 'brightness-0 invert']} />
        </div>
        <p class:list={['text-xs leading-relaxed', dark ? 'text-[#555]' : 'text-surface-500']}>
          Registru digital open-source pentru identitatea vizuală a instituțiilor publice din Republica Moldova.
          Un proiect civic, community-driven.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class:list={['text-xs font-semibold mb-2', dark ? 'text-[#888]' : 'text-primary-900']}>Navigare</h3>
        <ul class="space-y-0.5 text-xs">
          <li><a href="/" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Acasă</a></li>
          <li><a href="/despre" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Despre Proiect</a></li>
          <li><a href="/utilizare" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Documentație</a></li>
          <li><a href="/solicita" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Solicită un Logo</a></li>
          <li>
            <a href="https://github.com/ZLDR/IdentitateMD" target="_blank" rel="noopener" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>
              GitHub Repository
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class:list={['text-xs font-semibold mb-2', dark ? 'text-[#888]' : 'text-primary-900']}>Informații Legale</h3>
        <ul class="space-y-0.5 text-xs mb-3">
          <li><a href="/legal" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Drepturi de Autor & Termeni</a></li>
          <li><a href="/privacy" class:list={['transition-colors inline-block py-1.5', dark ? 'text-[#555] hover:text-[#aaa]' : 'text-surface-500 hover:text-primary-500']}>Politica de Confidențialitate</a></li>
        </ul>
        <div class:list={[
          'rounded p-2.5 border',
          dark ? 'bg-[#111] border-[#222]' : 'bg-amber-50 border-amber-200',
        ]}>
          <p class:list={['text-[11px] leading-relaxed', dark ? 'text-[#444]' : 'text-amber-800']}>
            Acest proiect nu este afiliat oficial Guvernului Republicii Moldova sau vreunei instituții publice. Logo-urile și identitățile vizuale sunt proprietatea instituțiilor respective. Informațiile sunt de interes public.
          </p>
        </div>
      </div>
    </div>

    <div class:list={[
      'mt-6 pt-6 border-t flex flex-col sm:flex-row justify-between items-center gap-3',
      dark ? 'border-[#1a1a1a]' : 'border-surface-200',
    ]}>
      <p class:list={['text-[11px]', dark ? 'text-[#444]' : 'text-surface-400']}>
        &copy; 2026 IdentitateMD Contributors. Licență MIT.
      </p>
      <p class:list={['text-[11px]', dark ? 'text-[#444]' : 'text-surface-400']}>
        Construit cu <a href="https://astro.build" target="_blank" class:list={['underline', dark ? 'hover:text-[#888]' : 'hover:text-primary-500']}>Astro</a> &middot;
        Găzduit pe <a href="https://vercel.com" target="_blank" class:list={['underline', dark ? 'hover:text-[#888]' : 'hover:text-primary-500']}>Vercel</a> &middot;
        Forked from <a href="https://github.com/laurentiucotet/IdentitateRO" target="_blank" rel="noopener" class:list={['underline', dark ? 'hover:text-[#888]' : 'hover:text-primary-500']}>IdentitateRO</a> &middot;
        Creat &amp; Menținut de <a href="https://shrift.md" target="_blank" rel="noopener" class:list={['underline', dark ? 'hover:text-[#888]' : 'hover:text-primary-500']}>Shrift</a>
      </p>
    </div>
  </div>
</footer>
