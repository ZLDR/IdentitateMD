---
import { CATEGORY_LABELS_SINGULAR } from '../lib/labels';
import { toLocalLogosPath } from '../lib/cdn-helpers';

export interface Props {
  slug: string;
  catalogPath?: string;
  name: string;
  shortname?: string;
  category: string;
  logoPath: string;
  hasSvg: boolean;
  keywords?: string[];
  className?: string;
  websiteUrl?: string;
  brandingManualUrl?: string;
}

const {
  slug,
  catalogPath,
  name,
  category,
  logoPath,
  hasSvg,
  className,
  websiteUrl,
  brandingManualUrl,
} = Astro.props;

const localPath = toLocalLogosPath(logoPath);
const imageSrc = localPath || logoPath;
const remoteFallbackPath = localPath && logoPath !== localPath ? logoPath : null;
const detailUrl = `/catalog/${catalogPath || slug}`;
const catLabel = CATEGORY_LABELS_SINGULAR[category] || category;
const downloadPath = localPath || logoPath;
---

<div
  class:list={['logo-card group', className]}
  data-institution-id={slug}
  data-card-category={category}
>
  <!-- Logo area -->
  <a href={detailUrl} class="block" tabindex="-1" aria-hidden="true">
    <div class="checkerboard flex items-center justify-center p-5 overflow-hidden" style="aspect-ratio: 4/3;">
      <img
        src={imageSrc}
        data-remote-fallback={remoteFallbackPath ?? undefined}
        alt={`Logo ${name}`}
        class="max-w-full max-h-full object-contain transition-transform duration-200 group-hover:scale-[1.04]"
        loading="lazy"
        decoding="async"
        onerror="const fb=this.dataset.remoteFallback; if(fb&&this.src!==fb){this.src=fb;return;} this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden flex-col items-center justify-center text-surface-400" role="img" aria-label="Logo indisponibil">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    </div>
  </a>

  <!-- Info area -->
  <div class="px-3 pt-2.5 pb-2">
    <a href={detailUrl} class="block group/name">
      <h3 class="font-medium text-[13px] text-primary-900 truncate leading-snug group-hover/name:text-primary-600 transition-colors" title={name}>
        {name}
      </h3>
    </a>
  </div>

  <!-- Action bar -->
  <div class="mt-auto px-2 py-2 border-t border-surface-100 flex items-center gap-0.5">
    {hasSvg && (
      <button
        class="card-action-btn"
        data-action="copy-svg"
        data-logo-path={logoPath}
        title="Copiază cod SVG"
        aria-label="Copiază cod SVG"
        type="button"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>
    )}

    {hasSvg && (
      <a
        href={downloadPath}
        download={`${slug}.svg`}
        class="card-action-btn"
        title="Descarcă SVG"
        aria-label="Descarcă SVG"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </a>
    )}

    {websiteUrl && (
      <a
        href={websiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="card-action-btn"
        title="Site oficial"
        aria-label="Site oficial"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}

    {brandingManualUrl && (
      <a
        href={brandingManualUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="card-action-btn"
        title="Manual de brand"
        aria-label="Manual de brand"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </a>
    )}

    <a
      href={detailUrl}
      class="card-action-btn ml-auto"
      title="Identitate vizuală & brand assets"
      aria-label="Identitate vizuală & brand assets"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
      </svg>
    </a>
  </div>
</div>
