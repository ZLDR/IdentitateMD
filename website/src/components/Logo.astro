---
/**
 * Logo.astro — Componenta reutilizabilă pentru logo-ul IdentitateMD
 * Folosește logo-identitate.svg din public/
 */
interface Props {
  /** Înălțimea logo-ului (default: h-7 pentru header) */
  class?: string;
  dark?: boolean;
}

const { class: className = 'h-7', dark = false } = Astro.props;
---

<img
  src={dark ? '/logo-identitate-dark.svg' : '/logo-identitate.svg'}
  alt="identitate.md"
  class={className}
  width="950"
  height="195"
  loading="eager"
/>
