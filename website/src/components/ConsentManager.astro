<aside
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-[100] hidden border-t border-surface-200 bg-white shadow-[0_-8px_30px_rgba(15,23,42,0.12)]"
  aria-label="Preferințe privind confidențialitatea"
>
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <div id="consent-summary">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-sm font-semibold text-primary-900">Tu alegi ce măsurăm</h2>
          <p class="mt-1 text-xs leading-relaxed text-surface-600">
            Folosim stocare esențială pentru a reține alegerea ta. Cu acordul tău, folosim Vercel Analytics
            și PostHog pentru statistici de utilizare. Analitica este oprită până alegi.
            <a href="/cookies" class="font-medium text-primary-700 underline underline-offset-2">Detalii despre cookie-uri și stocare</a>.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button data-consent-open type="button" class="rounded border border-surface-300 px-3 py-2 text-xs font-medium text-primary-800 hover:bg-surface-50">
            Preferințe
          </button>
          <button data-consent-reject type="button" class="rounded border border-primary-700 px-3 py-2 text-xs font-semibold text-primary-800 hover:bg-primary-50">
            Refuză opționale
          </button>
          <button data-consent-accept type="button" class="rounded border border-primary-700 px-3 py-2 text-xs font-semibold text-primary-800 hover:bg-primary-50">
            Acceptă analitica
          </button>
        </div>
      </div>
    </div>

    <section id="consent-preferences" class="hidden" aria-labelledby="consent-preferences-title">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="consent-preferences-title" class="text-sm font-semibold text-primary-900">Preferințe de consimțământ</h2>
          <p class="mt-1 text-xs leading-relaxed text-surface-600">
            Stocarea esențială reține opțiunea ta și nu poate fi dezactivată. Analitica este opțională și poate fi schimbată oricând.
          </p>
          <label class="mt-3 flex cursor-pointer items-start gap-3 rounded border border-surface-200 p-3">
            <input type="checkbox" checked disabled class="mt-0.5 accent-primary-700" />
            <span class="text-xs text-surface-700"><strong class="text-primary-900">Esențiale</strong><br />Rețin alegerea ta de confidențialitate.</span>
          </label>
          <label class="mt-2 flex cursor-pointer items-start gap-3 rounded border border-surface-200 p-3">
            <input id="consent-analytics-toggle" type="checkbox" class="mt-0.5 accent-primary-700" />
            <span class="text-xs text-surface-700"><strong class="text-primary-900">Analitică</strong><br />Permite statistici agregate și evenimente despre utilizarea catalogului prin Vercel Analytics și PostHog.</span>
          </label>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button data-consent-save type="button" class="rounded bg-primary-700 px-3 py-2 text-xs font-semibold text-white hover:bg-primary-800">
            Salvează alegerea
          </button>
          <button data-consent-reject type="button" class="rounded border border-surface-300 px-3 py-2 text-xs font-medium text-primary-800 hover:bg-surface-50">
            Refuză opționale
          </button>
          <button data-consent-back type="button" class="rounded border border-surface-300 px-3 py-2 text-xs font-medium text-primary-800 hover:bg-surface-50">
            Înapoi
          </button>
        </div>
      </div>
    </section>
  </div>
</aside>

<button
  id="consent-reopen"
  data-open-consent-settings
  type="button"
  class="fixed bottom-3 left-3 z-[90] hidden rounded-full border border-surface-300 bg-white px-3 py-2 text-[11px] font-medium text-primary-800 shadow-md hover:bg-surface-50"
  aria-label="Deschide preferințele de confidențialitate"
>
  Confidențialitate
</button>

<script>
  const STORAGE_KEY = 'identitate-md-consent-v1';
  const banner = document.querySelector<HTMLElement>('#consent-banner');
  const summary = document.querySelector<HTMLElement>('#consent-summary');
  const preferences = document.querySelector<HTMLElement>('#consent-preferences');
  const analyticsToggle = document.querySelector<HTMLInputElement>('#consent-analytics-toggle');
  const reopenButton = document.querySelector<HTMLButtonElement>('#consent-reopen');
  const CONSENT_MAX_AGE_MS = 180 * 24 * 60 * 60 * 1000;

  type SavedChoice = { version: 1; analytics: boolean; savedAt: string };

  function setHidden(element: HTMLElement | null, hidden: boolean) {
    element?.classList.toggle('hidden', hidden);
  }

  function readChoice(): SavedChoice | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const choice = JSON.parse(raw) as SavedChoice;
      const savedAt = Date.parse(choice.savedAt);
      if (choice.version !== 1 || typeof choice.analytics !== 'boolean' || !Number.isFinite(savedAt)) return null;
      return Date.now() - savedAt <= CONSENT_MAX_AGE_MS ? choice : null;
    } catch {
      return null;
    }
  }

  function hasAnalyticsConsent(): boolean {
    return readChoice()?.analytics === true;
  }

  function clearPostHogStorage() {
    try {
      localStorage.removeItem('ph_identitate-md-posthog');
      localStorage.removeItem('ph_phc_mPLrrJ7oC9UrV3DPSBn84ZJzAWm9SNWAVBwEUhNjQQoM_posthog');
    } catch {
      // Storage may be disabled by the browser.
    }

    const legacyCookie = 'ph_phc_mPLrrJ7oC9UrV3DPSBn84ZJzAWm9SNWAVBwEUhNjQQoM_posthog';
    for (const path of ['/', '']) {
      document.cookie = `${legacyCookie}=; Max-Age=0; path=${path || '/'}; SameSite=Lax`;
      document.cookie = `${legacyCookie}=; Max-Age=0; path=${path || '/'}; domain=.identitate.md; SameSite=Lax`;
    }
  }

  async function enableAnalytics() {
    if (!hasAnalyticsConsent()) return;

    try {
      const [{ default: posthog }, { inject }] = await Promise.all([
        import('posthog-js'),
        import('@vercel/analytics'),
      ]);

      if (!hasAnalyticsConsent()) return;

      if (!window.posthog) {
        posthog.init('phc_mPLrrJ7oC9UrV3DPSBn84ZJzAWm9SNWAVBwEUhNjQQoM', {
          api_host: 'https://t.identitate.md',
          defaults: '2026-01-30',
          opt_out_capturing_by_default: true,
          person_profiles: 'never',
          persistence: 'localStorage',
          persistence_name: 'identitate-md-posthog',
          autocapture: false,
          save_campaign_params: false,
          save_referrer: false,
          capture_pageview: false,
          capture_pageleave: false,
          disable_session_recording: true,
          before_send: (event) => {
            if (!hasAnalyticsConsent()) return null;
            const properties = event.properties as Record<string, unknown> | undefined;
            if (!properties) return event;
            event.properties = properties;
            for (const key of ['$current_url', '$referrer', '$initial_current_url', '$initial_referrer']) {
              const value = properties[key];
              if (typeof value !== 'string') continue;
              try {
                const url = new URL(value);
                properties[key] = `${url.origin}${url.pathname}`;
              } catch {
                delete properties[key];
              }
            }
            return event;
          },
        });
        posthog.opt_in_capturing();
        window.posthog = posthog;
      }

      if (!window.__identitateVercelAnalyticsLoaded) {
        inject({
          beforeSend: (event) => {
            if (!hasAnalyticsConsent()) return null;
            try {
              const url = new URL(event.url);
              return { ...event, url: `${url.origin}${url.pathname}` };
            } catch {
              return null;
            }
          },
        });
        window.__identitateVercelAnalyticsLoaded = true;
      }
    } catch {
      // Keep the site usable if either optional analytics provider is unavailable.
    }
  }

  function saveChoice(analytics: boolean) {
    const previousChoice = readChoice();
    const nextChoice: SavedChoice = {
      version: 1,
      analytics,
      savedAt: new Date().toISOString(),
    };

    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextChoice));
    } catch {
      // Without persistent storage, do not start analytics: consent cannot be remembered.
      if (analytics) return;
    }

    if (!analytics) {
      if (previousChoice?.analytics && window.posthog) {
        window.posthog.reset();
        window.posthog.opt_out_capturing();
        delete window.posthog;
      }
      clearPostHogStorage();
    }

    setHidden(banner, true);
    setHidden(reopenButton, false);
    if (analytics) void enableAnalytics();
  }

  function showPreferences() {
    if (!banner || !summary || !preferences || !analyticsToggle) return;
    analyticsToggle.checked = hasAnalyticsConsent();
    setHidden(summary, true);
    setHidden(preferences, false);
    setHidden(banner, false);
    setHidden(reopenButton, true);
    analyticsToggle.focus();
  }

  function showBanner() {
    if (!banner || !summary || !preferences) return;
    setHidden(summary, true);
    setHidden(preferences, false);
    setHidden(banner, false);
    setHidden(reopenButton, true);
  }

  if (banner && summary && preferences) {
    const choice = readChoice();
    if (!choice?.analytics) clearPostHogStorage();
    if (!choice) {
      setHidden(summary, false);
      setHidden(preferences, true);
      setHidden(banner, false);
      setHidden(reopenButton, true);
    } else if (choice.analytics) {
      setHidden(reopenButton, false);
      void enableAnalytics();
    } else {
      setHidden(reopenButton, false);
    }

    banner.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.closest('[data-consent-accept]')) saveChoice(true);
      if (target.closest('[data-consent-reject]')) saveChoice(false);
      if (target.closest('[data-consent-open]')) showPreferences();
      if (target.closest('[data-consent-back]')) {
        setHidden(summary, false);
        setHidden(preferences, true);
      }
      if (target.closest('[data-consent-save]')) saveChoice(analyticsToggle?.checked === true);
    });

    document.querySelectorAll<HTMLElement>('[data-open-consent-settings]').forEach((button) => {
      button.addEventListener('click', showPreferences);
    });

    window.addEventListener('storage', (event) => {
      if (event.key !== STORAGE_KEY) return;
      if (hasAnalyticsConsent()) void enableAnalytics();
      else if (window.posthog) {
        window.posthog.reset();
        window.posthog.opt_out_capturing();
        delete window.posthog;
      }
    });
  }
</script>
