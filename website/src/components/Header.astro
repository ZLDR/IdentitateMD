---
import Logo from './Logo.astro';
// Header component - Navbar-ul aplicației
const currentPath = Astro.url.pathname;

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'Acasă' },
  { href: '/catalog', label: 'Catalog' },
  { href: '/mcp', label: 'MCP', badge: 'Nou' },
  { href: '/despre', label: 'Despre' },
  { href: '/utilizare', label: 'Documentație' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class:list={[
  'sticky top-0 z-40 backdrop-blur-md border-b',
  dark
    ? 'bg-[#0a0a0a]/90 border-[#222]'
    : 'bg-white/80 border-surface-200',
]}>
  <div class="max-w-7xl mx-auto pl-0 pr-4 sm:px-6 lg:px-8">
    <nav class="h-12 flex items-center justify-start md:grid md:grid-cols-[auto_1fr_auto] md:items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center group shrink-0">
        <Logo class="h-7 max-w-[201px]" dark={dark} />
      </a>

      <!-- Navigation Links (Desktop) -->
      <div class="hidden md:flex items-center gap-4 justify-self-center">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-xs font-medium transition-colors inline-flex items-center gap-1.5',
              dark
                ? (isActive(link.href) ? 'text-blue-400' : 'text-white hover:text-[#ccc]')
                : (isActive(link.href) ? 'text-primary-600' : 'text-surface-600 hover:text-primary-900'),
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
            {link.badge && (
              <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-primary-100 text-primary-600 leading-none">
                {link.badge}
              </span>
            )}
          </a>
        ))}
        <a
          href="https://github.com/ZLDR/IdentitateMD"
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'text-xs font-medium transition-colors inline-flex items-center gap-1',
            dark ? 'text-white hover:text-[#ccc]' : 'text-surface-600 hover:text-primary-900',
          ]}
        >
          GitHub
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- CTA + Mobile Toggle -->
      <div class="ml-auto flex items-center gap-2 md:ml-0 md:justify-self-end">
        <a
          href="/solicita"
          class:list={[
            'text-xs sm:text-sm py-2 px-3 rounded border font-medium transition-colors',
            dark
              ? 'border-white bg-white text-black hover:bg-[#e5e5e5] hover:border-[#e5e5e5]'
              : 'btn-outline',
          ]}
        >
          Solicită Logo
        </a>
        <!-- Mobile Hamburger -->
        <button
          type="button"
          id="mobile-menu-btn"
          class:list={[
            'md:hidden p-2.5 -mr-1 rounded transition-colors',
            dark ? 'text-[#666] hover:bg-[#1a1a1a]' : 'text-surface-600 hover:bg-surface-100',
          ]}
          aria-label="Deschide meniul"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-5 h-5 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class:list={[
    'hidden md:hidden border-t',
    dark ? 'border-[#222] bg-[#0a0a0a]' : 'border-surface-200 bg-white',
  ]}>
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(link => {
        const mobileHref = link.href === '/catalog' ? '/catalog/guvern' : link.href;
        return (
        <a
          href={mobileHref}
          class:list={[
            'block px-3 py-2 rounded text-sm font-medium transition-colors',
            dark
              ? (isActive(link.href) ? 'bg-blue-950/40 text-blue-400' : 'text-[#666] hover:bg-[#1a1a1a] hover:text-[#ccc]')
              : (isActive(link.href) ? 'bg-primary-50 text-primary-600' : 'text-surface-600 hover:bg-surface-50 hover:text-primary-900'),
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      )})}
      <a
        href="https://github.com/ZLDR/IdentitateMD"
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          'block px-3 py-2 rounded text-sm font-medium transition-colors',
          dark ? 'text-[#666] hover:bg-[#1a1a1a] hover:text-[#ccc]' : 'text-surface-600 hover:bg-surface-50 hover:text-primary-900',
        ]}
      >
        GitHub &nearr;
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(!isOpen));
      menuBtn.querySelector('.menu-icon')?.classList.toggle('hidden');
      menuBtn.querySelector('.close-icon')?.classList.toggle('hidden');
    });
  }
</script>
