---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoCard from '../components/LogoCard.astro';
import Analytics from '@vercel/analytics/astro'
import institutionIndex from '../data/institutions-index.json';
import { getPrimaryLogoPath, hasSvg, getDisplayName, buildCatalogPathMap } from '../lib/helpers';
import { CATEGORY_LABELS, CATEGORY_ORDER } from '../lib/labels';
import type { Institution } from '../types/institution';

const institutions = institutionIndex.institutions as unknown as Institution[];
const catalogPathBySlug = buildCatalogPathMap(institutions);
const RECENT_ITEMS_LIMIT = 6;

function toTimestamp(value?: string): number {
  if (!value) return 0;
  const timestamp = Date.parse(value);
  return Number.isNaN(timestamp) ? 0 : timestamp;
}

const recentInstitutions = [...institutions]
  .sort((a, b) => {
    const bTime = toTimestamp(b.meta?.last_updated);
    const aTime = toTimestamp(a.meta?.last_updated);
    if (bTime !== aTime) return bTime - aTime;
    return a.name.localeCompare(b.name, "ro");
  })
  .slice(0, RECENT_ITEMS_LIMIT);

// Grupare pe categorii cu ordine prestabilită
const grouped = new Map<string, typeof institutions>();
for (const cat of CATEGORY_ORDER) {
  const items = institutions.filter(i => i.category === cat);
  if (items.length > 0) grouped.set(cat, items);
}

// Categoriile active (cele care au cel puțin o instituție)
const activeCategories = [...grouped.keys()];

// Build category labels map for JS
const categoryLabelsJson = JSON.stringify(CATEGORY_LABELS);
---

<BaseLayout
  title="identitate.md - Siglele Oficiale ale Instituțiilor Publice din Moldova"
  description={`Descarcă gratuit sigle vectoriale (SVG) ale instituțiilor publice din Republica Moldova. ${institutionIndex.total}+ instituții: ministere, agenții, primării. Culori HEX/RGB și tipografie oficială.`}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[70vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50/50 to-surface-50 -z-10"></div>
    <Analytics />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center w-full">
      <!-- MCP launch eyebrow -->
      <div class="mb-6">
        <a href="/mcp" class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-100 hover:bg-primary-200 border border-primary-200 transition-colors">
          <span class="text-[10px] font-semibold text-primary-600 uppercase tracking-widest">Nou</span>
          <span class="w-px h-3 bg-primary-300"></span>
          <span class="text-[12px] text-primary-800">MCP Disponibil</span>
          <svg class="w-3.5 h-3.5 text-primary-500 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary-900 leading-tight text-balance mb-3">
        Identitatea Vizuală<br />a Republicii Moldova, <span class="text-primary-500">centralizată.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-sm text-surface-500 max-w-xl mx-auto mb-12 text-balance">
        Sigle oficiale ale ministerelor, primăriilor și instituțiilor publice — în format SVG. Pentru designeri, dezvoltatori și agenții care lucrează pe proiecte moldovenești — fără căutat pe zeci de site-uri de ministere.
      </p>

      <!-- Search Input -->
      <div class="relative max-w-xl mx-auto" id="search-wrapper">
        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="search"
          id="search-input"
          class="search-input pl-12 pr-12 sm:text-[14px] text-sm"
          placeholder="Caută Primăria Municipiului Chișinău, Ministerul Educației..."
          data-placeholder-long={'Caută Primăria Municipiului Chișinău", „Ministerul Educației"...'}
          data-placeholder-short="Ministerul Educației..."
          autocomplete="off"
        />
        <!-- Keyboard shortcut hint — hidden on mobile (no physical keyboard) -->
        <div class="absolute inset-y-0 right-0 pr-4 hidden md:flex items-center pointer-events-none" id="search-shortcut">
          <kbd class="px-1.5 py-0.5 bg-surface-100 border border-surface-200 rounded text-[11px] text-surface-400 font-mono">/</kbd>
        </div>
        <div id="search-hint" class="mt-2 text-xs text-surface-400 hidden">
          <span class="hidden md:inline"><kbd class="px-1.5 py-0.5 bg-surface-100 rounded text-surface-500 font-mono">ESC</kbd> pentru a reseta</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Value Proposition -->
  <section class="bg-surface-50 border-y border-surface-200 hidden md:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 lg:gap-10 text-center sm:text-left">
        <div>
          <p class="text-xs font-semibold text-primary-700 uppercase tracking-widest mb-1">Sigle oficiale</p>
          <p class="text-xs text-surface-500">Nu imagini scanate sau recreate. Vectori descărcați direct din sursele instituțiilor sau reconstituiți cu fidelitate.</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-primary-700 uppercase tracking-widest mb-1">Actualizat la rebranduri</p>
          <p class="text-xs text-surface-500">Când o instituție se rebranduiește, catalogul se actualizează ca să nu mai verifici dacă sigla pe care o ai este în continuare cea curentă.</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-primary-700 uppercase tracking-widest mb-1">Menținut de comunitate</p>
          <p class="text-xs text-surface-500">Oricine poate contribui — adaugă o instituție lipsă, corectează o siglă, îmbunătățește metadatele. Totul e open-source pe GitHub.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter Bar — sticky on md+, scrolls away on mobile -->
  <section class="md:sticky md:top-12 z-30 bg-white/80 backdrop-blur-md border-b border-surface-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
      <!-- Overflow container with gradient hint -->
      <div class="relative">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide" id="filter-bar" role="tablist" aria-label="Filtrare după categorie">
          <button
            class="category-chip category-chip--active shrink-0"
            data-category="all"
          >
            Toate ({institutions.length})
          </button>
          {activeCategories.map(cat => (
            <button
              class="category-chip category-chip--inactive shrink-0"
              data-category={cat}
            >
              {CATEGORY_LABELS[cat] || cat} ({grouped.get(cat)?.length || 0})
            </button>
          ))}
        </div>
        <!-- Right gradient overlay to signal more chips -->
        <div class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-white/90 to-transparent md:hidden" id="filter-gradient"></div>
      </div>
    </div>
  </section>

  <!-- Active Filters Summary — removed: duplicates the filter chips bar above -->

  <!-- Logo Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Single DOM: Category Sections (cards are shown/hidden in-place) -->
    {recentInstitutions.length > 0 && (
      <div id="recent-section" class="mb-8">
        <h2 class="category-heading text-lg font-semibold text-primary-900 mb-1">
          Adăugate recent
        </h2>
        <p class="text-xs text-surface-500 mb-3">
          Cele mai recente instituții actualizate în catalog.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
          {recentInstitutions.map((inst, index) => {
            const visibilityClass =
              index >= 5 ? 'hidden sm:block lg:hidden' :
              index >= 3 ? 'hidden sm:block' :
              '';
            const logoPath = getPrimaryLogoPath(inst) || '';
            const hasSvgFlag = hasSvg(inst);
            return (
              <LogoCard
                slug={inst.slug}
                catalogPath={catalogPathBySlug[inst.slug]}
                name={inst.name}
                shortname={inst.shortname}
                category={inst.category}
                logoPath={logoPath}
                hasSvg={hasSvgFlag}
                keywords={inst.meta.keywords}
                className={visibilityClass}
              />
            );
          })}
        </div>
      </div>
    )}

    <div id="category-sections">
      {[...grouped.entries()].map(([cat, items]) => (
        <div class="category-section mb-8" data-category-section={cat}>
          <h2 class="category-heading text-lg font-semibold text-primary-900 mb-3">
            {CATEGORY_LABELS[cat] || cat}
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
            {items.map((inst) => {
              const logoPath = getPrimaryLogoPath(inst) || '';
              const hasSvgFlag = hasSvg(inst);
              return (
                <LogoCard
                  slug={inst.slug}
                  catalogPath={catalogPathBySlug[inst.slug]}
                  name={inst.name}
                  shortname={inst.shortname}
                  category={inst.category}
                  logoPath={logoPath}
                  hasSvg={hasSvgFlag}
                  keywords={inst.meta.keywords}
                />
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Empty state (dynamic content set via JS) -->
    <div id="empty-state" class="hidden py-20 text-center">
      <svg class="w-16 h-16 mx-auto mb-4 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="text-sm font-semibold text-primary-900 mb-2" id="empty-title">Niciun rezultat</h3>
      <p class="text-surface-500 text-xs mb-4" id="empty-message">Nu am găsit nicio instituție care să corespundă căutării tale.</p>
      <div id="empty-actions" class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <button type="button" id="empty-search-all" class="btn-secondary hidden">Caută în toate categoriile</button>
        <a href="/solicita" class="btn-primary">Solicită adăugarea</a>
      </div>
    </div>
  </section>

  <!-- For Developers -->
  <section class="bg-surface-50 border-t border-surface-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="text-[11px] font-medium text-surface-400 uppercase tracking-widest mb-1">Pentru Dezvoltatori</p>
      <p class="text-xs text-surface-500 mb-6">Integrează siglele direct în proiectul tău via npm sau în AI tools via MCP.</p>
      <div class="flex flex-col items-center gap-2" id="install-tabs">
        <!-- Tab buttons -->
        <div class="inline-flex items-center gap-1 bg-surface-100 border border-surface-200 rounded-md p-0.5">
          <button type="button" data-tab="npm" class="install-tab install-tab-active text-[11px] font-medium px-3 py-1 rounded transition-colors">npm</button>
          <button type="button" data-tab="mcp" class="install-tab text-[11px] font-medium px-3 py-1 rounded transition-colors">MCP</button>
        </div>

        <!-- npm panel -->
        <div data-panel="npm" class="install-panel inline-flex items-center gap-2 sm:gap-3 bg-surface-900 rounded-lg px-3 sm:px-4 py-2.5 font-mono text-xs sm:text-sm">
          <code class="text-white"><span class="text-green-400">npm i</span> @identitate-md/logos</code>
          <button
            type="button"
            class="copy-npm-btn p-2 -mr-1 rounded hover:bg-gray-700 text-gray-400 hover:text-gray-200 transition-colors shrink-0"
            data-value="npm install @identitate-md/logos"
            title="Copiază comanda"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>

        <!-- MCP panel -->
        <div data-panel="mcp" class="install-panel hidden inline-flex items-center gap-2 sm:gap-3 bg-surface-900 rounded-lg px-3 sm:px-4 py-2.5 font-mono text-xs sm:text-sm">
          <code class="text-white"><span class="text-blue-400">claude mcp add</span> identitate-md -- npx -y @identitate-md/mcp</code>
          <button
            type="button"
            class="copy-npm-btn p-2 -mr-1 rounded hover:bg-gray-700 text-gray-400 hover:text-gray-200 transition-colors shrink-0"
            data-value="claude mcp add identitate-md -- npx -y @identitate-md/mcp"
            title="Copiază comanda"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
      </div>
      <p class="mt-6 text-xs text-surface-400">
        <a href="/mcp" class="underline underline-offset-2 hover:text-surface-600 transition-colors">Documentație completă MCP →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<!-- Inline JSON data for client-side search & filter -->
<script define:vars={{ institutions: institutionIndex.institutions, categoryLabelsJson }}>
  window.__IDENTITATE_DATA__ = institutions;
  window.__CATEGORY_LABELS__ = JSON.parse(categoryLabelsJson);
</script>

<script>
  /**
   * IdentitateMD — Client-side interactivity (v4.0 — Mobile-first rewrite)
   * Single DOM, active filter pills, URL persistence, smart empty state
   */
  import Fuse from 'fuse.js';

  document.addEventListener('DOMContentLoaded', () => {

  const data = window.__IDENTITATE_DATA__;
  const LABELS: Record<string, string> = window.__CATEGORY_LABELS__;

  // Initialize Fuse.js for fuzzy search
  const fuse = new Fuse(data, {
    keys: [
      { name: 'name', weight: 0.4 },
      { name: 'shortname', weight: 0.3 },
      { name: 'meta.keywords', weight: 0.2 },
      { name: 'description', weight: 0.1 },
    ],
    threshold: 0.35,
    ignoreLocation: true,
    useExtendedSearch: false,
  });

  // DOM elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchShortcut = document.getElementById('search-shortcut')!;
  const filterBar = document.getElementById('filter-bar')!;
  const categorySections = document.getElementById('category-sections')!;
  const recentSection = document.getElementById('recent-section');
  const emptyState = document.getElementById('empty-state')!;
  const filterGradient = document.getElementById('filter-gradient');

  // Empty state elements
  const emptyTitle = document.getElementById('empty-title')!;
  const emptyMessage = document.getElementById('empty-message')!;
  const emptySearchAll = document.getElementById('empty-search-all')!;

  // Responsive placeholder
  function updatePlaceholder() {
    const isWide = window.innerWidth >= 640;
    searchInput.placeholder = isWide
      ? (searchInput.dataset.placeholderLong || searchInput.placeholder)
      : (searchInput.dataset.placeholderShort || searchInput.placeholder);
  }
  updatePlaceholder();
  window.addEventListener('resize', updatePlaceholder);

  // Hide / shortcut indicator when input is focused
  searchInput.addEventListener('focus', () => searchShortcut.classList.add('hidden'));
  searchInput.addEventListener('blur', () => {
    if (!searchInput.value) searchShortcut.classList.remove('hidden');
  });

  // State
  let activeCategory = 'all';
  let searchQuery = '';

  // ── URL State ───────────────────────────────────────────────────────
  function readUrlState() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('categorie') || params.get('cat');
    const q = params.get('q');
    if (cat && cat !== 'all') activeCategory = cat;
    if (q) {
      searchQuery = q;
      searchInput.value = q;
    }
  }

  function writeUrlState() {
    const params = new URLSearchParams();
    if (activeCategory !== 'all') params.set('categorie', activeCategory);
    if (searchQuery.trim()) params.set('q', searchQuery.trim());
    const qs = params.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    history.replaceState(null, '', url);
  }

  // ── Core filter/search ─────────────────────────────────────────────
  function filterAndSearch() {
    const query = searchQuery.toLowerCase().trim();
    const showRecentSection = activeCategory === 'all' && !query;
    recentSection?.classList.toggle('hidden', !showRecentSection);

    // Get matching slugs from search
    const matchingSlugs = query
      ? new Set(fuse.search(query).map(r => r.item.slug))
      : null;

    let totalVisible = 0;

    // Iterate over each category section
    categorySections.querySelectorAll<HTMLElement>('[data-category-section]').forEach(section => {
      const sectionCat = section.dataset.categorySection!;
      const cards = section.querySelectorAll<HTMLElement>('[data-institution-id]');
      const heading = section.querySelector('.category-heading') as HTMLElement;

      // If a specific category is selected and this isn't it, hide entire section
      if (activeCategory !== 'all' && sectionCat !== activeCategory) {
        section.classList.add('hidden');
        return;
      }

      let sectionVisible = 0;

      cards.forEach(card => {
        const slug = card.dataset.institutionId!;
        const matchesSearch = !query || (matchingSlugs && matchingSlugs.has(slug));

        if (matchesSearch) {
          card.classList.remove('hidden');
          sectionVisible++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Hide section if no visible cards, show otherwise
      section.classList.toggle('hidden', sectionVisible === 0);

      // Hide category headings when a specific category is selected (no need to show heading for only one category)
      if (heading) {
        heading.classList.toggle('hidden', activeCategory !== 'all');
      }

      totalVisible += sectionVisible;
    });

    // Empty state
    if (totalVisible === 0) {
      emptyState.classList.remove('hidden');
      categorySections.classList.add('hidden');

      // Smart empty state message
      const hasCategory = activeCategory !== 'all';
      const catLabel = LABELS[activeCategory] || activeCategory;
      if (hasCategory && query) {
        emptyTitle.textContent = 'Niciun rezultat';
        emptyMessage.textContent = `Nu am găsit „${searchQuery.trim()}" în categoria ${catLabel}.`;
        emptySearchAll.classList.remove('hidden');
        emptySearchAll.textContent = 'Caută în toate categoriile';
      } else if (query) {
        emptyTitle.textContent = 'Niciun rezultat';
        emptyMessage.textContent = `Nu am găsit nicio instituție pentru „${searchQuery.trim()}".`;
        emptySearchAll.classList.add('hidden');
      } else {
        emptyTitle.textContent = 'Niciun rezultat';
        emptyMessage.textContent = 'Nu am găsit nicio instituție care să corespundă căutării tale.';
        emptySearchAll.classList.add('hidden');
      }
    } else {
      emptyState.classList.add('hidden');
      categorySections.classList.remove('hidden');
    }

    // Update filter pills and URL
    writeUrlState();

    // Update filter bar active chip
    filterBar.querySelectorAll<HTMLElement>('[data-category]').forEach(chip => {
      if (chip.dataset.category === activeCategory) {
        chip.classList.remove('category-chip--inactive');
        chip.classList.add('category-chip--active');
      } else {
        chip.classList.remove('category-chip--active');
        chip.classList.add('category-chip--inactive');
      }
    });
  }

  // ── Event listeners ────────────────────────────────────────────────

  // Search input
  searchInput.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    searchShortcut.classList.toggle('hidden', !!searchQuery);
    filterAndSearch();
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      searchInput.value = '';
      searchQuery = '';
      activeCategory = 'all';
      filterAndSearch();
      searchInput.blur();
    }
  });

  // Category filter buttons
  filterBar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-category]') as HTMLElement;
    if (!btn) return;
    activeCategory = btn.dataset.category!;
    filterAndSearch();
  });

  // "Search in all categories" from empty state
  emptySearchAll.addEventListener('click', () => {
    activeCategory = 'all';
    filterAndSearch();
  });

  // Keyboard shortcut: focus search with /
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput.focus();
    }
  });

  // Filter bar gradient visibility (hide when scrolled to end)
  if (filterGradient) {
    const filterScroll = filterBar;
    function checkGradient() {
      if (!filterScroll) return;
      const atEnd = filterScroll.scrollLeft + filterScroll.clientWidth >= filterScroll.scrollWidth - 4;
      filterGradient!.classList.toggle('hidden', atEnd);
    }
    filterScroll.addEventListener('scroll', checkGradient, { passive: true });
    checkGradient();
  }

  // Read initial state from URL and apply
  readUrlState();
  filterAndSearch();

  });
</script>

<script>
  // Tab switching
  document.querySelectorAll('.install-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab!;
      document.querySelectorAll('.install-tab').forEach(t => t.classList.remove('install-tab-active'));
      btn.classList.add('install-tab-active');
      document.querySelectorAll('.install-panel').forEach(p => (p as HTMLElement).classList.add('hidden'));
      document.querySelector(`[data-panel="${tab}"]`)?.classList.remove('hidden');
    });
  });

  // Copy functionality for NPM command
  document.addEventListener('DOMContentLoaded', () => {
    const copyNpmBtn = document.querySelector('.copy-npm-btn');
    if (copyNpmBtn) {
      copyNpmBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        e.preventDefault();

        const btn = e.currentTarget as HTMLButtonElement;
        const textToCopy = btn.dataset.value!;

        try {
          await navigator.clipboard.writeText(textToCopy);

          // Visual feedback
          const originalIcon = btn.innerHTML;
          btn.innerHTML = `
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          `;
          setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);

        } catch (err) {
          console.error('Failed to copy:', err);
          const originalIcon = btn.innerHTML;
          btn.innerHTML = `
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          `;
          setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);
        }
      });
    }
  });
</script>
