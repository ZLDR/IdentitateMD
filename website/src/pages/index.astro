---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoCard from '../components/LogoCard.astro';
import Analytics from '@vercel/analytics/astro'
import institutionIndex from '../data/institutions-index.json';
import { getPrimaryLogoPath, hasSvg, buildCatalogPathMap } from '../lib/helpers';
import { CATEGORY_LABELS, CATEGORY_ORDER } from '../lib/labels';
import type { Institution } from '../types/institution';

const institutions = institutionIndex.institutions as unknown as Institution[];
const catalogPathBySlug = buildCatalogPathMap(institutions);

// Flat sorted list: by category order, then alphabetically within category
const sortedInstitutions = [...institutions].sort((a, b) => {
  const aIdx = CATEGORY_ORDER.indexOf(a.category as any);
  const bIdx = CATEGORY_ORDER.indexOf(b.category as any);
  if (aIdx !== bIdx) return (aIdx === -1 ? 99 : aIdx) - (bIdx === -1 ? 99 : bIdx);
  return a.name.localeCompare(b.name, 'ro');
});

// Category counts for sidebar
const categoryCounts = new Map<string, number>();
for (const inst of institutions) {
  categoryCounts.set(inst.category, (categoryCounts.get(inst.category) || 0) + 1);
}
const activeCategories = CATEGORY_ORDER.filter(cat => (categoryCounts.get(cat) || 0) > 0);

const categoryLabelsJson = JSON.stringify(CATEGORY_LABELS);
const total = institutions.length;
---

<BaseLayout
  title="identitate.md - Siglele Oficiale ale Instituțiilor Publice din Moldova"
  description={`Descarcă gratuit sigle vectoriale (SVG) ale instituțiilor publice din Republica Moldova. ${total}+ instituții: ministere, agenții, primării. Culori HEX/RGB și tipografie oficială.`}
  noHeader={true}
  noFooter={true}
>
  <Analytics />

  <div class="flex flex-col lg:flex-row min-h-screen bg-white">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SIDEBAR (desktop only)                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <aside class="hidden lg:flex flex-col w-[220px] shrink-0 border-r border-surface-200 bg-white sticky top-0 h-screen overflow-hidden">

      <!-- Brand -->
      <div class="px-4 pt-5 pb-3.5 border-b border-surface-100">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-identitate.svg" alt="identitate.md" class="h-[22px]" />
        </a>
      </div>

      <!-- Navigation -->
      <nav class="px-2 pt-2.5 pb-2 space-y-0.5 border-b border-surface-100">
        <a href="/" class="sidebar-nav-item font-medium text-primary-900 bg-surface-100" aria-current="page">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Acasă
        </a>
        <a href="/mcp" class="sidebar-nav-item">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
          </svg>
          MCP
          <span class="ml-auto text-[9px] font-bold uppercase tracking-wide bg-primary-100 text-primary-600 px-1.5 py-0.5 rounded">Nou</span>
        </a>
        <a href="/utilizare" class="sidebar-nav-item">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Documentație
        </a>
        <a href="https://github.com/ZLDR/IdentitateMD" target="_blank" rel="noopener noreferrer" class="sidebar-nav-item">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>
      </nav>

      <!-- Solicită logo CTA -->
      <div class="px-2 py-2.5 border-b border-surface-100">
        <a
          href="/solicita"
          class="flex items-center justify-center gap-1.5 w-full py-1.5 px-3 rounded border border-surface-200 text-[12px] font-medium text-surface-600 hover:bg-surface-50 hover:border-surface-300 transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          Solicită logo
        </a>
      </div>

      <!-- Categories list (scrollable) -->
      <div class="flex-1 overflow-y-auto py-2 px-2 scrollbar-hide">
        <p class="px-1 pt-1 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-surface-400">
          Categorii
        </p>

        <button class="sidebar-cat-item sidebar-cat-active" data-sidebar-cat="all" type="button">
          <span>Toate</span>
          <span class="text-[11px] text-surface-400 shrink-0 tabular-nums">{total}</span>
        </button>

        {activeCategories.map(cat => (
          <button class="sidebar-cat-item" data-sidebar-cat={cat} type="button">
            <span class="truncate">{CATEGORY_LABELS[cat]}</span>
            <span class="text-[11px] text-surface-400 shrink-0 tabular-nums">{categoryCounts.get(cat)}</span>
          </button>
        ))}
      </div>

    </aside>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- MAIN AREA                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="flex-1 flex flex-col min-w-0">

      <!-- Mobile: compact top bar -->
      <div class="lg:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-surface-200 px-4 py-3 flex items-center gap-3">
        <a href="/" class="flex items-center shrink-0">
          <img src="/logo-identitate.svg" alt="identitate.md" class="h-5" />
        </a>
        <div class="flex-1 relative">
          <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
            <svg class="w-3.5 h-3.5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="search"
            id="search-input-mobile"
            class="search-input-field w-full pl-8 pr-3 py-1.5 text-sm bg-surface-50 border border-surface-200 rounded-md placeholder-surface-400 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 transition-all"
            placeholder="Caută..."
            autocomplete="off"
          />
        </div>
        <a href="/solicita" class="shrink-0 text-[11px] font-medium border border-surface-200 rounded px-2 py-1 text-surface-600 hover:bg-surface-50 transition-colors">
          Solicită logo
        </a>
      </div>

      <!-- Mobile: category chips scroll -->
      <div class="lg:hidden border-b border-surface-200 bg-white">
        <!-- Nav links row -->
        <div class="flex items-center gap-4 px-4 pt-2 pb-1.5 text-[11px] text-surface-500">
          <a href="/mcp" class="hover:text-primary-700 flex items-center gap-1 transition-colors">
            MCP
            <span class="text-[9px] font-bold uppercase bg-primary-100 text-primary-600 px-1 py-0.5 rounded">Nou</span>
          </a>
          <a href="/utilizare" class="hover:text-primary-700 transition-colors">Documentație</a>
          <a href="https://github.com/ZLDR/IdentitateMD" target="_blank" rel="noopener" class="hover:text-primary-700 transition-colors">GitHub</a>
        </div>
        <!-- Category chips -->
        <div class="flex items-center gap-1.5 px-4 pb-3 overflow-x-auto scrollbar-hide">
          <button class="category-chip category-chip--active shrink-0 !min-h-0 !py-1.5 !px-3 !text-[11px]" data-mobile-cat="all" type="button">
            Toate ({total})
          </button>
          {activeCategories.map(cat => (
            <button class="category-chip category-chip--inactive shrink-0 !min-h-0 !py-1.5 !px-3 !text-[11px]" data-mobile-cat={cat} type="button">
              {CATEGORY_LABELS[cat]} ({categoryCounts.get(cat)})
            </button>
          ))}
        </div>
      </div>

      <!-- Desktop: search bar -->
      <div class="hidden lg:block border-b border-surface-200 bg-white" id="search-wrapper">
        <div class="px-6 py-3 relative">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="search"
              id="search-input-desktop"
              class="search-input-field w-full pl-9 pr-20 py-2 text-sm bg-white border border-surface-200 rounded-md placeholder-surface-400 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 transition-all"
              placeholder="Caută instituție..."
              autocomplete="off"
            />
            <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none gap-0.5">
              <kbd class="px-1.5 py-0.5 bg-surface-100 border border-surface-200 rounded text-[10px] text-surface-400 font-mono">⌘</kbd>
              <kbd class="px-1.5 py-0.5 bg-surface-100 border border-surface-200 rounded text-[10px] text-surface-400 font-mono">K</kbd>
            </div>

            <!-- Search dropdown -->
            <div id="search-dropdown" class="absolute top-full left-0 right-0 mt-1 bg-white border border-surface-200 rounded-lg shadow-xl hidden z-[100] max-h-[380px] overflow-y-auto">
              <div id="search-dropdown-results" class="py-1.5"></div>
              <div id="search-dropdown-footer" class="px-4 py-2 border-t border-surface-100 text-[11px] text-surface-400 flex items-center justify-between">
                <span id="search-dropdown-count"></span>
                <span>
                  <kbd class="px-1 py-0.5 bg-surface-100 rounded font-mono text-[10px]">↑↓</kbd> navigare ·
                  <kbd class="px-1 py-0.5 bg-surface-100 rounded font-mono text-[10px]">Enter</kbd> selectare ·
                  <kbd class="px-1 py-0.5 bg-surface-100 rounded font-mono text-[10px]">Esc</kbd> închide
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scrollable content -->
      <div class="flex-1 bg-surface-50">
        <div class="px-4 lg:px-6 py-5">

          <!-- Count row -->
          <div class="flex items-center justify-between mb-4">
            <p class="text-[13px] text-surface-500 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
              </svg>
              <span id="count-display">{total} instituții</span>
            </p>
          </div>

          <!-- Logo grid (flat) -->
          <div
            id="main-grid"
            class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-3 sm:gap-4"
          >
            {sortedInstitutions.map((inst) => {
              const logoPath = getPrimaryLogoPath(inst) || '';
              const hasSvgFlag = hasSvg(inst);
              return (
                <LogoCard
                  slug={inst.slug}
                  catalogPath={catalogPathBySlug[inst.slug]}
                  name={inst.name}
                  shortname={inst.shortname}
                  category={inst.category}
                  logoPath={logoPath}
                  hasSvg={hasSvgFlag}
                  keywords={inst.meta.keywords}
                  websiteUrl={inst.resources?.website}
                  brandingManualUrl={inst.resources?.branding_manual}
                />
              );
            })}
          </div>

          <!-- Empty state -->
          <div id="empty-state" class="hidden py-20 text-center">
            <svg class="w-14 h-14 mx-auto mb-4 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-sm font-semibold text-primary-900 mb-2">Niciun rezultat</h3>
            <p class="text-surface-500 text-xs mb-4" id="empty-message">Nu am găsit nicio instituție care să corespundă căutării tale.</p>
            <a href="/solicita" class="btn-primary">Solicită adăugarea</a>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none"></div>

</BaseLayout>

<!-- Pass data to client -->
<script define:vars={{ institutions: institutionIndex.institutions, categoryLabelsJson, catalogPathBySlug }}>
  window.__IDENTITATE_DATA__ = institutions;
  window.__CATEGORY_LABELS__ = JSON.parse(categoryLabelsJson);
  window.__CATALOG_PATHS__ = catalogPathBySlug;
</script>

<script>
  import Fuse from 'fuse.js';

  document.addEventListener('DOMContentLoaded', () => {

    const data: any[] = (window as any).__IDENTITATE_DATA__;
    const LABELS: Record<string, string> = (window as any).__CATEGORY_LABELS__;
    const catalogPaths: Record<string, string> = (window as any).__CATALOG_PATHS__;

    // ── Fuse.js ──────────────────────────────────────────
    const fuse = new Fuse(data, {
      keys: [
        { name: 'name', weight: 0.4 },
        { name: 'shortname', weight: 0.3 },
        { name: 'meta.keywords', weight: 0.2 },
        { name: 'description', weight: 0.1 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
    });

    // ── State ────────────────────────────────────────────
    let activeCategory = 'all';
    let searchQuery = '';

    // ── DOM refs ─────────────────────────────────────────
    const mainGrid = document.getElementById('main-grid')!;
    const emptyState = document.getElementById('empty-state')!;
    const emptyMessage = document.getElementById('empty-message')!;
    const countDisplay = document.getElementById('count-display')!;
    const allCards = document.querySelectorAll<HTMLElement>('[data-institution-id]');
    const searchDropdown = document.getElementById('search-dropdown')!;
    const searchDropdownResults = document.getElementById('search-dropdown-results')!;
    const searchDropdownCount = document.getElementById('search-dropdown-count')!;

    let highlightedIdx = -1;
    let dropdownResults: any[] = [];

    // ── Logo path helper (for dropdown thumbnails) ───────
    function getLogoPath(inst: any): string {
      const main = inst.assets?.main;
      if (!main) return '';
      for (const asset of [main.color, main.dark_mode, main.black, main.white, main.monochrome]) {
        if (asset) {
          const p = typeof asset === 'string' ? asset : (asset?.local || asset?.cdn_primary || '');
          if (p) return p;
        }
      }
      return main.png?.path || '';
    }

    // ── Toast ────────────────────────────────────────────
    function showToast(message: string, type: 'success' | 'error' = 'success') {
      const container = document.getElementById('toast-container')!;
      const el = document.createElement('div');
      el.className = `px-4 py-2.5 rounded-lg text-sm font-medium shadow-lg ${
        type === 'success' ? 'bg-surface-900 text-white' : 'bg-red-600 text-white'
      }`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => {
        el.style.transition = 'opacity 0.25s';
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 260);
      }, 2000);
    }

    // ── URL state ────────────────────────────────────────
    function readUrlState() {
      const p = new URLSearchParams(window.location.search);
      const cat = p.get('categorie') || p.get('cat');
      const q = p.get('q');
      if (cat && cat !== 'all') activeCategory = cat;
      if (q) {
        searchQuery = q;
        document.querySelectorAll<HTMLInputElement>('.search-input-field').forEach(el => { el.value = q; });
      }
    }

    function writeUrlState() {
      const p = new URLSearchParams();
      if (activeCategory !== 'all') p.set('categorie', activeCategory);
      if (searchQuery.trim()) p.set('q', searchQuery.trim());
      const qs = p.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    }

    // ── Filter & search ──────────────────────────────────
    function filterAndSearch() {
      const query = searchQuery.toLowerCase().trim();
      const hits = query ? new Set(fuse.search(query).map((r: any) => r.item.slug)) : null;
      let visible = 0;

      allCards.forEach(card => {
        const slug = card.dataset.institutionId!;
        const cat = card.dataset.cardCategory!;
        const matchCat = activeCategory === 'all' || cat === activeCategory;
        const matchSearch = !hits || hits.has(slug);
        const show = matchCat && matchSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      // Update count label
      countDisplay.textContent = `${visible} ${visible === 1 ? 'instituție' : 'instituții'}`;

      // Empty state
      const isEmpty = visible === 0;
      emptyState.classList.toggle('hidden', !isEmpty);
      mainGrid.classList.toggle('hidden', isEmpty);
      if (isEmpty && query) {
        emptyMessage.textContent = `Nu am găsit nicio instituție pentru „${searchQuery.trim()}".`;
      } else if (isEmpty) {
        emptyMessage.textContent = 'Nu am găsit nicio instituție în această categorie.';
      }

      updateActiveButtons();
      writeUrlState();
    }

    function updateActiveButtons() {
      document.querySelectorAll<HTMLElement>('[data-sidebar-cat]').forEach(btn => {
        btn.classList.toggle('sidebar-cat-active', btn.dataset.sidebarCat === activeCategory);
      });
      document.querySelectorAll<HTMLElement>('[data-mobile-cat]').forEach(btn => {
        const isActive = btn.dataset.mobileCat === activeCategory;
        btn.classList.toggle('category-chip--active', isActive);
        btn.classList.toggle('category-chip--inactive', !isActive);
      });
    }

    // ── Search dropdown ───────────────────────────────────
    function showDropdown() { searchDropdown.classList.remove('hidden'); }
    function hideDropdown() {
      searchDropdown.classList.add('hidden');
      highlightedIdx = -1;
      dropdownResults = [];
    }

    function updateDropdown(query: string) {
      if (!query.trim()) { hideDropdown(); return; }

      const results = fuse.search(query).map((r: any) => r.item);
      dropdownResults = results;

      if (results.length === 0) {
        searchDropdownResults.innerHTML = `<div class="px-4 py-8 text-center text-sm text-surface-500">Niciun rezultat pentru „${query}"</div>`;
        searchDropdownCount.textContent = '';
        showDropdown();
        return;
      }

      const max = 5;
      const shown = results.slice(0, max);

      searchDropdownResults.innerHTML = shown.map((inst: any, idx: number) => `
        <a
          href="/catalog/${catalogPaths[inst.slug]}"
          class="search-result-item flex items-center gap-2.5 px-3 py-2 hover:bg-surface-50 transition-colors ${idx === highlightedIdx ? 'bg-surface-50' : ''}"
          data-index="${idx}"
        >
          <div class="w-8 h-8 shrink-0 rounded bg-surface-100 border border-surface-200 flex items-center justify-center p-1 overflow-hidden">
            <img src="${getLogoPath(inst)}" alt="${inst.name}" class="max-w-full max-h-full object-contain" loading="lazy" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-medium text-sm text-primary-900 truncate">${inst.name}</div>
            <div class="text-[11px] text-surface-500">${LABELS[inst.category] || inst.category}</div>
          </div>
          <svg class="w-3.5 h-3.5 text-surface-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      `).join('');

      searchDropdownCount.textContent = `${results.length} rezultat${results.length === 1 ? '' : 'e'}`;

      if (results.length > max) {
        searchDropdownResults.innerHTML += `
          <div class="px-4 py-2 border-t border-surface-100 text-center text-[11px] text-surface-400">
            +${results.length - max} mai multe rezultate
          </div>
        `;
      }

      showDropdown();
    }

    function setHighlight(idx: number) {
      highlightedIdx = idx;
      searchDropdownResults.querySelectorAll('.search-result-item').forEach((el, i) => {
        el.classList.toggle('bg-surface-50', i === idx);
      });
      const el = searchDropdownResults.querySelectorAll('.search-result-item')[idx];
      if (el) (el as HTMLElement).scrollIntoView({ block: 'nearest' });
    }

    // ── Desktop search input ──────────────────────────────
    const desktopInput = document.getElementById('search-input-desktop') as HTMLInputElement;
    const mobileInput = document.getElementById('search-input-mobile') as HTMLInputElement;

    function syncInputs(value: string, source: HTMLInputElement) {
      [desktopInput, mobileInput].forEach(el => {
        if (el && el !== source) el.value = value;
      });
    }

    desktopInput?.addEventListener('input', e => {
      searchQuery = (e.target as HTMLInputElement).value;
      syncInputs(searchQuery, e.target as HTMLInputElement);
      updateDropdown(searchQuery);
      filterAndSearch();
    });

    desktopInput?.addEventListener('focus', () => {
      if (searchQuery) updateDropdown(searchQuery);
    });

    desktopInput?.addEventListener('keydown', e => {
      const max = Math.min(dropdownResults.length, 5);
      if (e.key === 'Escape') {
        if (!searchDropdown.classList.contains('hidden')) {
          hideDropdown();
        } else {
          desktopInput.value = '';
          searchQuery = '';
          activeCategory = 'all';
          filterAndSearch();
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (searchDropdown.classList.contains('hidden') && searchQuery) updateDropdown(searchQuery);
        else setHighlight(highlightedIdx < max - 1 ? highlightedIdx + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setHighlight(highlightedIdx > 0 ? highlightedIdx - 1 : max - 1);
      } else if (e.key === 'Enter' && highlightedIdx >= 0 && dropdownResults[highlightedIdx]) {
        window.location.href = `/catalog/${catalogPaths[dropdownResults[highlightedIdx].slug]}`;
      }
    });

    mobileInput?.addEventListener('input', e => {
      searchQuery = (e.target as HTMLInputElement).value;
      syncInputs(searchQuery, e.target as HTMLInputElement);
      filterAndSearch();
    });

    // ── Keyboard shortcuts ────────────────────────────────
    document.addEventListener('keydown', e => {
      if (
        (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k')) &&
        document.activeElement !== desktopInput &&
        document.activeElement !== mobileInput
      ) {
        e.preventDefault();
        (window.innerWidth >= 1024 ? desktopInput : mobileInput)?.focus();
      }
    });

    // ── Global click delegation ───────────────────────────
    document.addEventListener('click', async e => {
      const target = e.target as HTMLElement;

      // Sidebar category button
      const sidebarBtn = target.closest<HTMLElement>('[data-sidebar-cat]');
      if (sidebarBtn) {
        activeCategory = sidebarBtn.dataset.sidebarCat!;
        filterAndSearch();
        return;
      }

      // Mobile category chip
      const mobileChip = target.closest<HTMLElement>('[data-mobile-cat]');
      if (mobileChip) {
        activeCategory = mobileChip.dataset.mobileCat!;
        filterAndSearch();
        return;
      }

      // Copy SVG action button
      const copyBtn = target.closest<HTMLElement>('[data-action="copy-svg"]');
      if (copyBtn) {
        e.preventDefault();
        const logoPath = copyBtn.dataset.logoPath!;
        try {
          const res = await fetch(logoPath);
          if (!res.ok) throw new Error();
          const svg = await res.text();
          await navigator.clipboard.writeText(svg);
          showToast('SVG copiat în clipboard!');
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = `<svg class="w-3.5 h-3.5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
          setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
        } catch {
          showToast('Eroare la copiere', 'error');
        }
        return;
      }

      // Close dropdown on outside click
      const searchWrapper = document.getElementById('search-wrapper');
      if (searchWrapper && !searchWrapper.contains(target)) {
        hideDropdown();
      }
    });

    // ── Init ──────────────────────────────────────────────
    readUrlState();
    filterAndSearch();

  });
</script>
