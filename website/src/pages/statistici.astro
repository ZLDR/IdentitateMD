---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Statistici de utilizare | identitate.md" description="Cele mai descărcate și copiate logo-uri, numărate anonim." noindex>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/" class="inline-flex items-center gap-2 text-sm text-primary-600 hover:text-primary-700 mb-4">← Înapoi la pagina principală</a>
    <h1 class="text-3xl font-bold text-primary-900 mb-3">Statistici de utilizare</h1>
    <p class="text-surface-600 mb-6">
      Descărcări și copieri de logo-uri, numărate anonim (fără IP, fără identificatori, fără cookie-uri). Datele sunt agregate zilnic și actualizate la câteva minute.
    </p>

    <div class="mb-6 flex flex-wrap gap-2" id="stats-range">
      <button type="button" data-days="7" class="rounded-lg border border-surface-200 px-3 py-1.5 text-sm">7 zile</button>
      <button type="button" data-days="14" class="rounded-lg border border-surface-200 px-3 py-1.5 text-sm">14 zile</button>
      <button type="button" data-days="30" class="rounded-lg border border-surface-200 px-3 py-1.5 text-sm">30 de zile</button>
      <button type="button" data-days="90" class="rounded-lg border border-surface-200 px-3 py-1.5 text-sm">90 de zile</button>
    </div>

    <p id="stats-status" class="text-sm text-surface-500">Se încarcă...</p>

    <div id="stats-content" class="hidden space-y-8">
      <section>
        <h2 class="mb-2 text-lg font-semibold text-primary-900">Pe instituție</h2>
        <div class="overflow-x-auto rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-50 text-surface-600">
              <tr><th class="p-3">Instituție</th><th class="p-3">Descărcări</th><th class="p-3">Copieri</th><th class="p-3">ZIP</th><th class="p-3">Total</th></tr>
            </thead>
            <tbody id="stats-by-institution" class="divide-y divide-surface-200"></tbody>
          </table>
        </div>
      </section>
      <section>
        <h2 class="mb-2 text-lg font-semibold text-primary-900">Cele mai folosite fișiere</h2>
        <div class="overflow-x-auto rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-50 text-surface-600">
              <tr><th class="p-3">Instituție</th><th class="p-3">Fișier</th><th class="p-3">Acțiune</th><th class="p-3">Număr</th></tr>
            </thead>
            <tbody id="stats-by-asset" class="divide-y divide-surface-200"></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  type Row = { event: string; institution: string; asset: string; count: number };
  const ACTION: Record<string, string> = { download: 'descărcare', copy: 'copiere', zip: 'ZIP' };

  const status = document.getElementById('stats-status')!;
  const content = document.getElementById('stats-content')!;
  const byInstitution = document.getElementById('stats-by-institution')!;
  const byAsset = document.getElementById('stats-by-asset')!;

  const cell = (text: string | number, extra = '') => {
    const td = document.createElement('td');
    td.className = `p-3 ${extra}`;
    td.textContent = String(text);
    return td;
  };
  const row = (cells: HTMLElement[]) => {
    const tr = document.createElement('tr');
    cells.forEach((c) => tr.appendChild(c));
    return tr;
  };

  function render(rows: Row[]) {
    const totals = new Map<string, { download: number; copy: number; zip: number }>();
    for (const r of rows) {
      const t = totals.get(r.institution) || { download: 0, copy: 0, zip: 0 };
      if (r.event in t) t[r.event as 'download' | 'copy' | 'zip'] += r.count;
      totals.set(r.institution, t);
    }
    byInstitution.replaceChildren(
      ...[...totals]
        .map(([inst, t]) => ({ inst, ...t, total: t.download + t.copy + t.zip }))
        .sort((a, b) => b.total - a.total)
        .map((t) => row([cell(t.inst, 'font-medium'), cell(t.download), cell(t.copy), cell(t.zip), cell(t.total, 'font-semibold')])),
    );
    byAsset.replaceChildren(
      ...rows
        .filter((r) => r.event !== 'zip')
        .slice(0, 50)
        .map((r) => row([cell(r.institution, 'font-medium'), cell(r.asset), cell(ACTION[r.event] || r.event), cell(r.count, 'font-semibold')])),
    );
    status.textContent = rows.length ? '' : 'Nu există încă date pentru acest interval.';
    content.classList.toggle('hidden', !rows.length);
  }

  async function load(days: number) {
    status.textContent = 'Se încarcă...';
    try {
      const res = await fetch(`/api/stats?days=${days}`);
      if (!res.ok) throw new Error(String(res.status));
      render((await res.json()).rows || []);
    } catch {
      content.classList.add('hidden');
      status.textContent = 'Statisticile nu sunt disponibile momentan.';
    }
    document.querySelectorAll<HTMLElement>('#stats-range button').forEach((b) => {
      const active = b.dataset.days === String(days);
      b.classList.toggle('bg-primary-50', active);
      b.classList.toggle('border-primary-400', active);
    });
  }

  document.querySelectorAll<HTMLElement>('#stats-range button').forEach((b) =>
    b.addEventListener('click', () => load(Number(b.dataset.days))),
  );
  load(14);
</script>
