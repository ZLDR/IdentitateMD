---
import BaseLayout from '../../layouts/BaseLayout.astro';
import institutionIndex from '../../data/institutions-index.json';
import { resolveAssetPath, CDN_VERSION } from '../../lib/cdn-helpers';
import { buildCatalogPathMap } from '../../lib/helpers';
import {
  CATEGORY_LABELS,
  CATEGORY_LABELS_SINGULAR,
  LOGO_LAYOUT_LABELS,
  LOGO_VARIANT_LABELS,
  COLOR_USAGE_LABELS,
  QUALITY_LABELS,
} from '../../lib/labels';
import type { Institution } from '../../types/institution';

const CATEGORY_ORDER = [
  'guvern', 'minister', 'parlament', 'directie', 'agentie', 'autoritate', 'primarie',
  'consiliu-judetean', 'prefectura', 'proiect-ue', 'institutie-cultura', 'servicii', 'consilii', 'universitate', 'altele',
];

const allInstitutions = institutionIndex.institutions as unknown as Institution[];
const catalogPathBySlug = buildCatalogPathMap(allInstitutions);
const slugByCatalogPath = Object.fromEntries(
  Object.entries(catalogPathBySlug).map(([slug, pathId]) => [pathId, slug])
);
for (const inst of allInstitutions) {
  slugByCatalogPath[inst.slug] = inst.slug;
}
const { initialPathId = '', pageTitle: propTitle, pageDescription: propDesc, ogImage: propOgImage, institutionJsonLd, breadcrumbJsonLd } = Astro.props;

const categories = CATEGORY_ORDER
  .map(value => ({
    value,
    label: CATEGORY_LABELS[value] || value,
    count: allInstitutions.filter(i => i.category === value).length,
  }))
  .filter(c => c.count > 0);

const institutionsByCategory = categories.reduce((acc, cat) => {
  acc[cat.value] = allInstitutions.filter(i => i.category === cat.value);
  return acc;
}, {} as Record<string, Institution[]>);

const title = propTitle || "Catalog Sigle | identitate.md";
const description = propDesc || `Explorează siglele vectoriale oficiale ale celor ${institutionIndex.total} instituții publice din Republica Moldova. Descarcă gratuit în format SVG, culori HEX/RGB și tipografie.`;

const institutionsJson = JSON.stringify(allInstitutions);
const categoryLabelsSingularJson = JSON.stringify(CATEGORY_LABELS_SINGULAR);
const logoLayoutLabelsJson = JSON.stringify(LOGO_LAYOUT_LABELS);
const logoVariantLabelsJson = JSON.stringify(LOGO_VARIANT_LABELS);
const colorUsageLabelsJson = JSON.stringify(COLOR_USAGE_LABELS);
const qualityLabelsJson = JSON.stringify(QUALITY_LABELS);
const catalogPathBySlugJson = JSON.stringify(catalogPathBySlug);
const slugByCatalogPathJson = JSON.stringify(slugByCatalogPath);
const cdnVersion = CDN_VERSION;
---

<BaseLayout title={title} description={description} ogType="website" ogImage={propOgImage}>
  {institutionJsonLd && (
    <script slot="head" type="application/ld+json" set:html={institutionJsonLd} />
  )}
  {breadcrumbJsonLd && (
    <script slot="head" type="application/ld+json" set:html={breadcrumbJsonLd} />
  )}
  <!-- Catalog: three-pane layout: categories | institutions | detail -->
  <div class="flex h-full overflow-hidden">

    <!-- ═══ SIDEBAR 1: Categories ═══ -->
    <aside
      id="sidebar-categories"
      class="w-48 shrink-0 border-r border-surface-200 bg-surface-50 hidden lg:flex lg:flex-col"
    >
      <div class="px-3 py-3 border-b border-surface-100">
        <span class="text-[11px] font-semibold text-surface-400 uppercase tracking-wider">Categorii</span>
      </div>
      <nav class="flex-1 overflow-y-auto py-2 space-y-0.5 px-2">
        {categories.map((cat, i) => (
          <button
            type="button"
            data-category-btn={cat.value}
            class:list={[
              "category-btn w-full text-left px-3 py-2 rounded text-sm transition-colors flex items-center justify-between",
              i === 0
                ? "bg-primary-50 text-primary-700 font-medium"
                : "text-surface-700 hover:bg-surface-100"
            ]}
          >
            <span class="truncate">{cat.label}</span>
            <span class="text-xs text-surface-400 tabular-nums">{cat.count}</span>
          </button>
        ))}
      </nav>
    </aside>

    <!-- ═══ SIDEBAR 2: Institutions ═══ -->
    <aside
      id="sidebar-institutions"
      class="w-60 shrink-0 border-r border-surface-200 bg-white hidden lg:flex lg:flex-col"
    >
      <!-- Search + Sort header -->
      <div class="px-3 py-2 border-b border-surface-100 space-y-2">
        <div class="relative">
          <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="catalog-search"
            placeholder="Caută..."
            class="w-full pl-7 pr-8 py-1.5 text-sm border border-surface-200 rounded focus:outline-none focus:border-primary-400"
          />
          <button
            type="button"
            id="search-clear"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-surface-300 hover:text-surface-500 hidden"
            aria-label="Golește căutarea"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="flex items-center gap-1">
          <span class="text-[11px] text-surface-400 flex-1" id="sidebar-count"></span>
          <button type="button" id="sort-az" data-sort="az" class="sort-btn px-2 py-0.5 rounded text-[11px] font-medium bg-primary-50 text-primary-600" title="Sortare A→Z">A–Z</button>
          <button type="button" id="sort-za" data-sort="za" class="sort-btn px-2 py-0.5 rounded text-[11px] font-medium text-surface-400 hover:bg-surface-100" title="Sortare Z→A">Z–A</button>
        </div>
      </div>
      <!-- Institution list -->
      <nav id="institutions-list" class="flex-1 overflow-y-auto py-1 min-h-0">
        {categories.map((cat) => (
          <div data-category-group={cat.value} class="institution-group">
            <div class="px-3 py-1.5 text-[10px] font-semibold text-surface-400 uppercase tracking-wider sticky top-0 bg-white/95 backdrop-blur-sm z-10">
              {cat.label}
            </div>
            {institutionsByCategory[cat.value].map((inst: Institution) => {
              const mainAsset =
                inst.assets?.main?.color
                || inst.assets?.main?.dark_mode
                || inst.assets?.main?.black
                || inst.assets?.main?.white
                || inst.assets?.main?.monochrome;
              const logoSrc = mainAsset ? resolveAssetPath(mainAsset, false) : null;
              return (
                <a
                  href={`/catalog/${catalogPathBySlug[inst.slug] || inst.slug}`}
                  data-institution-btn={inst.slug}
                  class="institution-btn block w-full text-left px-3 py-2 hover:bg-surface-50 transition-colors flex items-center gap-2 group"
                  data-name={`${inst.shortname || inst.name} ${inst.name}`}
                  data-category={inst.category}
                >
                  <span class="w-7 h-7 rounded border border-surface-100 bg-white flex items-center justify-center shrink-0 overflow-hidden">
                    {logoSrc
                      ? <img src={logoSrc} alt="" class="w-6 h-6 object-contain" loading="lazy" />
                      : <span class="text-surface-300 text-[10px]">?</span>
                    }
                  </span>
                  <span class="truncate text-sm text-surface-700 group-hover:text-primary-700">
                    {inst.shortname?.toUpperCase() || inst.name}
                  </span>
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    </aside>

    <!-- ═══ MAIN: Institution Detail ═══ -->
    <main id="catalog-main" class="flex-1 min-w-0 overflow-y-auto bg-white">
      <!-- Placeholder while no institution is loaded -->
      <div id="catalog-placeholder" class="flex-col items-center justify-center h-full text-center p-12 hidden">
        <svg class="w-16 h-16 text-surface-200 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-surface-400 text-sm">Selectează o instituție din listă</p>
      </div>
      <!-- Detail content injected by JS -->
      <div id="institution-detail" class="p-6 max-w-4xl mx-auto"></div>
    </main>
  </div>

  <!-- ═══ MOBILE: Floating Browse Button ═══ -->
  <div class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2">
    <button
      id="mobile-fab"
      type="button"
      class="flex items-center gap-2 px-5 py-3 bg-white text-surface-500 border border-surface-200 rounded-full shadow-md hover:border-primary-300 hover:text-primary-600 active:scale-95 transition-all text-sm font-medium whitespace-nowrap"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      Caută instituții
    </button>
    <button
      id="mobile-share-btn"
      type="button"
      class="w-11 h-11 px-0 inline-flex items-center justify-center gap-0 bg-white text-surface-500 border border-surface-200 rounded-full shadow-md hover:border-primary-300 hover:text-primary-600 active:scale-95 transition-all duration-300 ease-out"
      title="Distribuie"
      aria-label="Distribuie"
    >
      <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
      </svg>
      <span id="mobile-share-label" class="text-xs font-medium whitespace-nowrap overflow-hidden max-w-0 opacity-0 -translate-x-1 transition-all duration-300 ease-out">Link copiat</span>
    </button>
  </div>

  <!-- ═══ MOBILE: Bottom Sheet Backdrop ═══ -->
  <div id="mobile-sheet-backdrop" class="lg:hidden fixed inset-0 z-40 bg-black/40 hidden" aria-hidden="true"></div>

  <!-- ═══ MOBILE: Bottom Sheet ═══ -->
  <div
    id="mobile-sheet"
    class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-white rounded-t-2xl shadow-2xl flex flex-col translate-y-full transition-transform duration-300 ease-out"
    style="max-height: 85vh"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-sheet-title"
  >
    <!-- Drag handle -->
    <div class="flex justify-center pt-3 pb-2 shrink-0">
      <div class="w-9 h-1 rounded-full bg-surface-200"></div>
    </div>
    <!-- Sheet header -->
    <div class="flex items-center justify-between px-4 pb-2 shrink-0">
      <span id="mobile-sheet-title" class="font-semibold text-primary-900">Instituții</span>
      <button id="mobile-sheet-close" type="button" class="p-1.5 rounded-full hover:bg-surface-100 text-surface-400 hover:text-surface-600 transition-colors" aria-label="Închide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <!-- Search -->
    <div class="px-4 pb-3 shrink-0">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-surface-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="mobile-sheet-search"
          type="text"
          placeholder="Caută instituție..."
          class="w-full pl-9 pr-8 py-2.5 text-sm border border-surface-200 rounded-xl focus:outline-none focus:border-primary-400 bg-surface-50"
        />
        <button
          id="mobile-sheet-search-clear"
          type="button"
          class="absolute right-2.5 top-1/2 -translate-y-1/2 text-surface-300 hover:text-surface-500 hidden"
          aria-label="Golește"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    <!-- Institution list -->
    <div id="mobile-sheet-list" class="flex-1 overflow-y-auto pb-8">
      {categories.map((cat) => (
        <div data-sheet-group={cat.value} class="mobile-sheet-group">
          <div class="px-4 py-2 text-[10px] font-semibold text-surface-400 uppercase tracking-wider sticky top-0 bg-white/95 backdrop-blur-sm">
            {cat.label}
          </div>
          {institutionsByCategory[cat.value].map((inst: Institution) => {
            const mainAsset =
              inst.assets?.main?.color
              || inst.assets?.main?.dark_mode
              || inst.assets?.main?.black
              || inst.assets?.main?.white
              || inst.assets?.main?.monochrome;
            const logoSrc = mainAsset ? resolveAssetPath(mainAsset, false) : null;
            return (
              <button
                type="button"
                data-sheet-inst-btn={inst.slug}
                data-name={`${inst.shortname || inst.name} ${inst.name}`}
                class="mobile-sheet-inst-btn w-full text-left px-4 py-3 hover:bg-surface-50 active:bg-surface-100 flex items-center gap-3 transition-colors"
              >
                <span class="w-8 h-8 rounded border border-surface-100 bg-white flex items-center justify-center shrink-0 overflow-hidden">
                  {logoSrc
                    ? <img src={logoSrc} alt="" class="w-7 h-7 object-contain" loading="lazy" />
                    : <span class="text-surface-300 text-[10px]">?</span>
                  }
                </span>
                <span class="truncate text-sm text-surface-700">{inst.shortname?.toUpperCase() || inst.name}</span>
              </button>
            );
          })}
        </div>
      ))}
    </div>
  </div>

</BaseLayout>

<script define:vars={{ institutionsJson, categoryLabelsSingularJson, logoLayoutLabelsJson, logoVariantLabelsJson, colorUsageLabelsJson, qualityLabelsJson, catalogPathBySlugJson, slugByCatalogPathJson, initialPathId, cdnVersion }} is:inline>
window.__catalogData = {
  institutions: JSON.parse(institutionsJson),
  CATEGORY_LABELS_SINGULAR: JSON.parse(categoryLabelsSingularJson),
  LAYOUT_LABELS: JSON.parse(logoLayoutLabelsJson),
  VARIANT_LABELS: JSON.parse(logoVariantLabelsJson),
  USAGE_LABELS: JSON.parse(colorUsageLabelsJson),
  QUALITY_LABELS: JSON.parse(qualityLabelsJson),
  PATH_BY_SLUG: JSON.parse(catalogPathBySlugJson),
  SLUG_BY_PATH: JSON.parse(slugByCatalogPathJson),
  initialPathId,
  cdnVersion,
};
</script>

<script>
  import { attachCatalogController } from '../../lib/catalog-controller';

  attachCatalogController();
</script>

<style>
  .institution-btn.hidden { display: none; }
  .mobile-sheet-inst-btn.hidden { display: none; }
  .mobile-sheet-group.hidden { display: none; }
</style>
