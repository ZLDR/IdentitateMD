---
import CatalogPage from './index.astro';
import institutionIndex from '../../data/institutions-index.json';
import { buildCatalogPathMap, getPrimaryLogoPath } from '../../lib/helpers';
import type { Institution, InstitutionCategory } from '../../types/institution';

export async function getStaticPaths() {
  const institutions = institutionIndex.institutions as unknown as Institution[];
  const catalogPathBySlug = buildCatalogPathMap(institutions);
  const pathToInst = new Map<string, Institution>();

  for (const inst of institutions) {
    const pathId = catalogPathBySlug[inst.slug] || inst.slug;
    pathToInst.set(pathId, inst);
  }

  return [...pathToInst.entries()].map(([id, inst]) => ({
    params: { id },
    props: { initialPathId: id, institution: inst },
  }));
}

const { initialPathId, institution } = Astro.props as { initialPathId: string; institution: Institution };

const shortLabel = institution.shortname?.trim() || '';
const seoLabel = shortLabel && shortLabel.length <= 8 && /^[A-Za-z0-9]+$/.test(shortLabel)
  ? shortLabel.toUpperCase()
  : shortLabel;

const pageTitle = institution
  ? institution.meta?.seo_title || `${seoLabel || institution.name} logo și sigla oficială | identitate.md`
  : undefined;

const pageDescription = institution
  ? institution.meta?.seo_description || `Descarcă logo-ul și sigla oficială a ${institution.name}${seoLabel ? ` (${seoLabel})` : ''} în format SVG. Variante cromatice, culori HEX/RGB și tipografie.`
  : undefined;

const primaryLogoPath = institution ? getPrimaryLogoPath(institution) : null;
const ogImage = primaryLogoPath
  ? primaryLogoPath.startsWith('http')
    ? primaryLogoPath
    : `https://identitate.md${primaryLogoPath}`
  : undefined;

const breadcrumbJsonLd = institution ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://identitate.md" },
    { "@type": "ListItem", "position": 2, "name": "Catalog", "item": "https://identitate.md/catalog" },
    { "@type": "ListItem", "position": 3, "name": institution.name, "item": `https://identitate.md/catalog/${initialPathId}` }
  ]
}) : undefined;

const organizationSchemaTypes: Partial<Record<InstitutionCategory, string>> = {
  guvern: 'GovernmentOrganization',
  minister: 'GovernmentOrganization',
  parlament: 'GovernmentOrganization',
  directie: 'GovernmentOrganization',
  agentie: 'GovernmentOrganization',
  autoritate: 'GovernmentOrganization',
  primarie: 'GovernmentOrganization',
  'consiliu-judetean': 'GovernmentOrganization',
  prefectura: 'GovernmentOrganization',
  servicii: 'GovernmentOrganization',
  consilii: 'GovernmentOrganization',
  universitate: 'CollegeOrUniversity',
  'institutie-cultura': 'Organization',
};

const schemaType = institution ? organizationSchemaTypes[institution.category] : undefined;
const logoPath = institution ? getPrimaryLogoPath(institution) : null;
const logoUrl = logoPath
  ? logoPath.startsWith('http')
    ? logoPath
    : `https://identitate.md${logoPath}`
  : undefined;
const socialProfiles = institution?.resources?.social_media
  ? Object.values(institution.resources.social_media).filter((url): url is string => Boolean(url))
  : [];
const sameAs = [
  ...(institution?.resources?.website ? [institution.resources.website] : []),
  ...socialProfiles,
];
const institutionJsonLd = institution && schemaType ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  "@id": `https://identitate.md/catalog/${initialPathId}#organization`,
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "identitate.md institution ID",
    "value": institution.id,
  },
  "name": institution.name,
  ...(institution.shortname && { "alternateName": institution.shortname }),
  ...(institution.description && { "description": institution.description }),
  ...(institution.resources?.website && { "url": institution.resources.website }),
  ...(logoUrl && {
    "logo": {
      "@type": "ImageObject",
      "url": logoUrl,
      "name": `Logo ${institution.name}${institution.shortname ? ` (${institution.shortname})` : ''}`,
      "description": `Logo asociat instituției în registrul identitate.md: ${institution.name}`,
      ...(/\.svg(?:$|[?#])/i.test(logoUrl) && { "encodingFormat": "image/svg+xml" }),
      "contentUrl": logoUrl
    }
  }),
  ...(institution.meta?.keywords?.length && { "keywords": institution.meta.keywords.join(', ') }),
  ...(sameAs.length > 0 && { "sameAs": sameAs }),
}) : undefined;
---

<CatalogPage
  initialPathId={initialPathId}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  ogImage={ogImage}
  institutionJsonLd={institutionJsonLd}
  breadcrumbJsonLd={breadcrumbJsonLd}
  isInstitutionPage={Boolean(institution)}
  institutionName={institution?.name}
/>
