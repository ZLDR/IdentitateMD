---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  noFooter?: boolean;
  noHeader?: boolean;
  darkChrome?: boolean;
}

const { title, description, ogImage, ogType, noindex, noFooter, noHeader, darkChrome = false }: Props = Astro.props;

const pageTitle = title || 'identitate.md - Siglele Oficiale ale Instituțiilor Publice din Moldova';
const pageDescription = description || 'Registru digital open-source cu sigle vectoriale (SVG) ale instituțiilor publice din Republica Moldova. Descarcă gratuit logo-uri, culori HEX/RGB și tipografie pentru ministere, agenții și primării.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage || new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="ro" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="identitate vizuala, sigle institutii Moldova, logo guvern, SVG logos Moldova, brand colors, Republica Moldova, visual identity, government branding" />
    <meta name="author" content="identitate.md Community" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="identitate.md" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#004990" />


    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "identitate.md",
      "alternateName": "IdentitateMD",
      "url": "https://identitate.md",
      "description": "Open-source digital registry of official visual identities for public institutions in the Republic of Moldova. Provides free SVG logos, brand colors (HEX/RGB), and typography for 28+ government institutions.",
      "inLanguage": ["ro", "en"],
      "publisher": {
        "@type": "Organization",
        "name": "identitate.mdCommunity",
        "url": "https://identitate.md"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://identitate.md/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": "identitate.md- Registry of Moldovan Public Institution Visual Identities",
      "description": "A comprehensive open dataset of official logos, brand colors, and visual identity assets for public institutions in the Republic of Moldova. Includes SVG vector logos in multiple layouts and color variants, official HEX/RGB color values, and typography specifications.",
      "url": "https://identitate.md",
      "license": "https://identitate.md/legal",
      "creator": {
        "@type": "Organization",
        "name": "identitate.mdCommunity",
        "url": "https://identitate.md"
      },
      "keywords": [
        "Moldova", "government logos", "SVG", "brand identity", "open data",
        "sigle institutii", "identitate vizuala", "logo vectorial", "Republica Moldova"
      ],
      "inLanguage": "ro",
      "isAccessibleForFree": true,
      "distribution": [
        {
          "@type": "DataDownload",
          "encodingFormat": "application/json",
          "contentUrl": "https://identitate.md/api/institutions.json"
        },
        {
          "@type": "DataDownload",
          "encodingFormat": "text/plain",
          "contentUrl": "https://identitate.md/llms-full.txt"
        }
      ]
    })} />

    <!-- Page-specific head content (JSON-LD, etc.) -->
    <slot name="head" />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    {!noHeader && <Header dark={darkChrome} />}
    <main class="flex-1 min-h-0">
      <slot />
    </main>
    {!noFooter && <Footer dark={darkChrome} />}
    <script is:inline>
      window.webAnalyticsBeforeSend = function(event) {
        if (localStorage.getItem('notrack') === '1') return null;
        return event;
      };
    </script>
    <Analytics />

    <script>
      import posthog from 'posthog-js';
      posthog.init(import.meta.env.PUBLIC_POSTHOG_KEY, {
        api_host: import.meta.env.PUBLIC_POSTHOG_HOST,
        defaults: '2026-01-30',
      });
    </script>

    <script>
      if (import.meta.env.DEV) {
        Promise.all([
          import('react'),
          import('react-dom/client'),
          import('agentation'),
        ]).then(([React, ReactDOM, { Agentation }]) => {
          const container = document.createElement('div');
          document.body.appendChild(container);
          ReactDOM.createRoot(container).render(React.createElement(Agentation, { endpoint: 'http://localhost:4747' }));
        });
      }
    </script>
  </body>
</html>
